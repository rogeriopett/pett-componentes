{
    "name": "pett-componentes",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "main": "./dist/pett-componentes.umd.js",
    "module": "./dist/pett-componentes.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/pett-componentes.es.js",
            "require": "./dist/pett-componentes.umd.js"
        },
        "./style.css": "./dist/pett-componentes.css",
        "./temas/light.css": "./dist/temas/PettThemeLight.css",
        "./temas/dark.css": "./dist/temas/PettThemeDark.css",
        "./temas/industrial.css": "./dist/temas/PettThemeIndustrial.css",
        "./temas/reddark.css": "./dist/temas/PettThemeRedDark.css"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build && node scripts/copy-temas.mjs",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "files": [
        "dist"
    ],
    "peerDependencies": {
        "react": ">=19.3.0",
        "react-dom": ">=19.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.3.0"
    }
